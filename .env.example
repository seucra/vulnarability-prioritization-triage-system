# Vulnerability Prioritization & Triage System — Environment Variables Example
# Repository: seucra/vulnarability-prioritization-triage-system

# Secret Key for HMAC-SHA256 Token Signing
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Allowed CORS Origins (JSON list or comma-separated depending on environment)
ALLOWED_ORIGINS=["https://vuln-triage.seucra.tech","https://vuln-triage-api.seucra.tech","http://localhost:8000"]

# FastAPI Application Settings
PROJECT_NAME="WDL Vulnerability Prioritization Triage Backend"
REPOSITORY_NAME="seucra/vulnarability-prioritization-triage-system"
